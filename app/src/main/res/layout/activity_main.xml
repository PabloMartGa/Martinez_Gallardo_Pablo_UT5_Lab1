<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_principal">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:background="@color/cabecera_banner"
        android:text="@string/hint_long_press"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp"
        android:gravity="center" />

    <!-- ListView que será alimentado por EtapaAdapter -->
    <ListView
        android:id="@+id/lvEtapas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/divisor_lista"
        android:dividerHeight="1dp" />

</LinearLayout>